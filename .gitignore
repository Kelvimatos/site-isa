# ==============================================================================
# IM STORE — Arquivo .gitignore para Produção e GitHub Público
# ==============================================================================

# Variáveis de ambiente e credenciais
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example

# Configurações locais com chaves do projeto
assets/js/supabase-config.js
!assets/js/supabase-config.example.js

# Dependências
node_modules/
.pnp
.pnp.js

# Diretórios de build e distribuição
dist/
build/
.next/
out/
.nuxt/
.vuepress/dist/

# Plataformas de hospedagem (arquivos gerados)
.vercel/
.netlify/

# Cobertura de testes e relatórios
coverage/
.nyc_output/

# Logs e processos
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Arquivos de mídia pesados (> 50MB)
*.mp4
*.mov
*.avi

# Cache e temporários
.cache/
.parcel-cache/
tmp/
temp/
*.tmp
*.temp

# Perfis de automação e testes
chrome-profile-*/
.user_uploaded/
scratch/

# Certificados e chaves privadas
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Dumps e backups de banco de dados
*.sql.dump
*.dump
*.backup
*.bak

# Arquivos de sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editores e IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

