# ==============================================================================
# IM STORE — Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com os dados do seu ambiente:
#   cp .env.example .env
#
# NUNCA envie o arquivo .env ou suas credenciais reais ao repositório público.
# ==============================================================================

# Supabase BaaS (Dashboard > Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_aqui

# WhatsApp Oficial para Atendimento e Checkout (DDI + DDD + Número)
# Exemplo: 5511999999999
WHATSAPP_NUMBER=5511999999999

