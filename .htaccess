<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://jysjypyqsnqorqhtplxb.supabase.co https://*.supabase.co https://wa.me; connect-src 'self' https://jysjypyqsnqorqhtplxb.supabase.co wss://jysjypyqsnqorqhtplxb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me;"
</IfModule>

ErrorDocument 404 /404.html

